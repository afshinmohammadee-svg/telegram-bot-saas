{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/bot-menus",
      "destination": "/api/bots?resource=menus"
    },
    {
      "source": "/api/visitors",
      "destination": "/api/dashboard?resource=visitors"
    },
    {
      "source": "/api/auth/:authPath*",
      "destination": "/api/auth/dispatch?__authPath=:authPath*"
    }
  ]
}
